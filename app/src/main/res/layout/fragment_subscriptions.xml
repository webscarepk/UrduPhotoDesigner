<?xml version="1.0" encoding="utf-8"?>
<!--
  UrduCanvas Pro paywall — single hero card + segmented term toggle.
  Drop-in replacement for fragment_subscriptions.xml.
  All IDs referenced by the rewritten SubscriptionsFragment.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11331D"
    tools:context=".ui.navigation.settings.SubscriptionsFragment">

    <!-- Blurred template grid backdrop -->
    <ImageView
        android:id="@+id/mainBgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:src="@drawable/ic_subscription_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Close button -->
    <ImageView
        android:id="@+id/back"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_close_circle"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        app:tint="#3A3D39"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- White sheet -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_sheet_top_rounded"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="@string/app_name_pro"
                    android:textColor="#8A8F8A"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- ACTIVE subscription card (subscribed) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/activePlanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_active_card"
                android:padding="14dp"
                android:visibility="gone">

                <View
                    android:id="@+id/activeIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_crown_circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/subscriptionCardSubTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:fontFamily="@font/medium"
                    android:text="@string/active_plan"
                    android:textColor="#8A8F8A"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/activeIcon"
                    app:layout_constraintTop_toTopOf="@id/activeIcon"
                    app:layout_constraintEnd_toStartOf="@id/statusPill" />

                <TextView
                    android:id="@+id/subscriptionCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:fontFamily="@font/bold"
                    android:text="@string/monthly"
                    android:textColor="#2A2D29"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/activeIcon"
                    app:layout_constraintTop_toBottomOf="@id/subscriptionCardSubTitle"
                    app:layout_constraintBottom_toBottomOf="@id/activeIcon" />

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:text="Active"
                    android:textColor="#1D6B34"
                    android:textSize="11sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/activeDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="11dp"
                    android:background="#ECECEC"
                    app:layout_constraintTop_toBottomOf="@id/activeIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Facts row: Plan / Billed / Renew -->
                <LinearLayout
                    android:id="@+id/factsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/activeDivider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium"
                            android:text="Plan"
                            android:textColor="#9AA09A"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/factPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/bold"
                            android:text="6-Month"
                            android:textColor="#2A2D29"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium"
                            android:text="Billed"
                            android:textColor="#9AA09A"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/factBilled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/bold"
                            android:text="Rs. 1,800"
                            android:textColor="#2A2D29"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/factRenewLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium"
                            android:text="Renews on"
                            android:textColor="#9AA09A"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/factRenewDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/bold"
                            android:text="24 Jul 2026"
                            android:textColor="#2A2D29"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Time-in-period bar (NOT credits) -->
                <ProgressBar
                    android:id="@+id/periodBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="55"
                    android:progressDrawable="@drawable/period_bar"
                    app:layout_constraintTop_toBottomOf="@id/factsRow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/barNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Auto-renews on 24 Jul 2026."
                    android:textColor="#9AA09A"
                    android:textSize="10sp"
                    app:layout_constraintTop_toBottomOf="@id/periodBar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/manageLink" />

                <TextView
                    android:id="@+id/manageLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/bold"
                    android:text="Manage"
                    android:textColor="#1D6B34"
                    android:textSize="11sp"
                    app:layout_constraintTop_toTopOf="@id/barNote"
                    app:layout_constraintBottom_toBottomOf="@id/barNote"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FREE banner (not subscribed) -->
            <LinearLayout
                android:id="@+id/freeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_free_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_free_circle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="You're on the Free plan"
                        android:textColor="#2A2D29"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Unlock everything with Pro"
                        android:textColor="#8A8F8A"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Segmented term toggle -->
            <LinearLayout
                android:id="@+id/segmentToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:id="@+id/segMonthly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="Monthly"
                    android:textColor="#8A8F8A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/segSix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="6-Month"
                    android:textColor="#8A8F8A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/segYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="Yearly"
                    android:textColor="#8A8F8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hero card (selected plan) -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_hero_card"
                android:padding="18dp">

                <TextView
                    android:id="@+id/heroOffBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_button_gradient_wrap"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:text="25% OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/heroPlanName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="6-Month plan"
                    android:textColor="#5D625D"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/heroPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/bold"
                    android:text="Rs. 300"
                    android:textColor="#1C1F1B"
                    android:textSize="34sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroPlanName" />

                <TextView
                    android:id="@+id/heroOrigPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/bold"
                    android:text="Rs. 400"
                    android:textColor="#B9BDB8"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/heroPrice"
                    app:layout_constraintStart_toEndOf="@id/heroPrice" />

                <TextView
                    android:id="@+id/heroPerMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/medium"
                    android:text="per month"
                    android:textColor="#9AA09A"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/heroPrice"
                    app:layout_constraintStart_toEndOf="@id/heroOrigPrice" />

                <TextView
                    android:id="@+id/heroBilledLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/medium"
                    android:text="Rs. 1,800 billed · Every 6 months"
                    android:textColor="#7C817C"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroPrice" />

                <TextView
                    android:id="@+id/heroSaveBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_save_banner"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="Save Rs. 600 / year"
                    android:textColor="#1D6B34"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroBilledLine" />

                <View
                    android:id="@+id/heroDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:background="#ECECEC"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroSaveBanner" />

                <!-- Benefits injected at runtime -->
                <LinearLayout
                    android:id="@+id/benefitsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroDivider" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#66091E12" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer (CTA + note + links) -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_footer"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="11dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/continueBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_button_gradient_wrap"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:padding="15dp"
            android:text="@string/continue_"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ctaNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="No commitment · cancel anytime"
            android:textColor="#9AA09A"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/termsOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_of_use"
                android:textColor="#9AA09A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="·"
                android:textColor="#DADCD7"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/privacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="#9AA09A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="·"
                android:textColor="#DADCD7"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/restore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore"
                android:textColor="#9AA09A"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
