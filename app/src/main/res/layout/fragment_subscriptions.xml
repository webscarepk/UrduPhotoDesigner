<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.navigation.settings.SubscriptionsFragment">

    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/sub_free_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:translationZ="6dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toStartOf="@id/hero"
        app:layout_constraintEnd_toEndOf="@id/hero"
        app:layout_constraintTop_toBottomOf="@id/hero"
        app:layout_constraintBottom_toBottomOf="@id/hero">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/appColor"
            android:contentDescription="@string/urdu_canvas_pro"
            android:padding="8dp"
            android:src="@drawable/ic_rate"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/sub_free_title"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/infoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="@string/sub_free_subtitle"
                android:textColor="@color/gray"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Active badge — shown only when subscribed -->
        <TextView
            android:id="@+id/activeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/state_green_tint"
            android:fontFamily="@font/bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/mng_chip_active"
            android:textColor="@color/state_green"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- ── Hero banner ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/sub_header_gradient"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="50dp"
        android:translationZ="5dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Toolbar row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/appColorLow"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Headline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:text="@string/sub_hero_title"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/regular"
            android:text="@string/sub_hero_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Scrollable content ──────────────────────────────────────────────── -->
    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintTop_toBottomOf="@id/infoCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <!-- Skeleton (shown until Play Billing returns the plans) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                shimmer:shimmer_auto_start="true"
                shimmer:shimmer_duration="1100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/sub_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/sub_skeleton_block" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Real content (revealed when plans load) -->
            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Segmented term toggle -->
                <FrameLayout
                    android:id="@+id/segmentTrack"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/sub_segment_track"
                    android:padding="4dp">

                    <View
                        android:id="@+id/segmentThumb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/sub_segment_thumb" />

                    <LinearLayout
                        android:id="@+id/segmentTabs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </FrameLayout>

                <!-- Detail card + BEST VALUE ribbon wrapper -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/detailCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sub_card_outline"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/termLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:text="@string/sub_term_6month"
                            android:textColor="@color/appColor"
                            android:textSize="13sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/discountPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sub_discount_pill"
                            android:fontFamily="@font/bold"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/save_25"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/priceMain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:text="@string/rs_399"
                            android:textColor="@color/sub_price_text"
                            android:textSize="38sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/termLabel" />

                        <TextView
                            android:id="@+id/priceStrike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/medium"
                            android:text="@string/rs_399"
                            android:textColor="@color/sub_strike"
                            android:textSize="18sp"
                            app:layout_constraintBaseline_toBaselineOf="@id/priceMain"
                            app:layout_constraintStart_toEndOf="@id/priceMain" />

                        <TextView
                            android:id="@+id/priceSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/regular"
                            android:text="@string/per_month"
                            android:textColor="@color/gray"
                            android:textSize="13sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/priceMain" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/saveShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toBottomOf="@id/priceSub"
                            shimmer:shimmer_auto_start="true"
                            shimmer:shimmer_base_alpha="1"
                            shimmer:shimmer_duration="1600"
                            shimmer:shimmer_highlight_alpha="0.9">

                            <TextView
                                android:id="@+id/saveLine"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/sub_save_bg"
                                android:fontFamily="@font/bold"
                                android:gravity="center"
                                android:paddingTop="11dp"
                                android:paddingBottom="11dp"
                                android:text="@string/sub_save_line"
                                android:textColor="@color/sub_save_text"
                                android:textSize="13sp" />
                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <View
                            android:id="@+id/detailDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/sub_divider"
                            app:layout_constraintTop_toBottomOf="@id/saveShimmer" />

                        <TextView
                            android:id="@+id/benefitsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/bold"
                            android:letterSpacing="0.08"
                            android:text="@string/sub_benefits_header"
                            android:textColor="@color/gray"
                            android:textSize="11sp"
                            app:layout_constraintTop_toBottomOf="@id/detailDivider" />

                        <LinearLayout
                            android:id="@+id/featuresList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@id/benefitsHeader" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>

    <!-- ── Sticky footer ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/continueBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_button_gradient_wrap"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btnIdleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/bold"
                android:text="@string/sub_cta_subscribe"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/btnSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/sub_cta_subscribed"
                    android:padding="7dp"
                    android:src="@drawable/ic_done" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/bold"
                    android:text="@string/sub_cta_subscribed"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/ctaNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="@font/regular"
            android:gravity="center"
            android:text="@string/no_commitment_cancel_anytime"
            android:textColor="@color/gray"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/termsOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_of_use"
                android:textColor="@color/gray"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="·"
                android:textColor="@color/gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/privacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="@color/gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
