<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    tools:context=".ui.navigation.settings.subscriptions.SubscriptionsFragment">

    <!-- ── Fixed top bar (does not scroll) ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_close"
            app:tint="@color/black" />
    </LinearLayout>

    <!-- ── Scrollable content ──────────────────────────────────────────────── -->
    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Headline -->
            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/sub_hero_title"
                android:textColor="@color/black"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="@string/sub_hero_subtitle"
                android:textColor="@color/gray"
                android:textSize="13sp" />

            <!-- Skeleton (shown until Play Billing returns the plans) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                shimmer:shimmer_auto_start="true"
                shimmer:shimmer_duration="1100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@drawable/sub_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/sub_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/sub_skeleton_block" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Real content (revealed when plans load) -->
            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── Eid banner / popular templates slideshow ─────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bannerCard"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="18dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Rotating template thumbnails -->
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/templateSlider"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Note: the scrim + big italic headline used to live
                             here as static overlays — the headline always
                             said "Eid Mubarak" no matter which template was
                             showing. Both now live inside
                             layout_subscription_template_slide.xml instead,
                             so the scrim + headline change per template. -->

                        <!-- "200+ templates" pill -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="14dp"
                            android:background="@drawable/sub_discount_pill"
                            android:backgroundTint="@color/white"
                            android:fontFamily="@font/bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/sub_templates_count"
                            android:textColor="@color/appColor"
                            android:textSize="10sp" />

                        <!-- Slide dots -->
                        <LinearLayout
                            android:id="@+id/sliderDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal|bottom"
                            android:layout_margin="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />

                        <!-- Bottom text block -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_margin="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/bold"
                                android:text="@string/sub_banner_title"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/regular"
                                android:text="@string/sub_banner_subtitle"
                                android:textColor="#CCFFFFFF"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3-up plan cards — SpringRecyclerView instead of plain
                     RecyclerView so any overscroll bounces with the same
                     spring physics as the vertical SpringNestedScrollView,
                     instead of the default edge-glow. -->
                <com.webscare.urducanvas.common.views.SpringRecyclerView
                    android:id="@+id/planList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="always"
                    tools:itemCount="3"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/layout_subscriptions_item"
                    tools:orientation="horizontal" />

                <!-- "Rs 400 billed every month · cancel anytime" caption -->
                <TextView
                    android:id="@+id/ctaNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:text="@string/no_commitment_cancel_anytime"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />

                <!-- ── 3x3 feature grid ────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/featureRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                    <include
                        android:id="@+id/featureFonts"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"/>

                    <include
                        android:id="@+id/featureTemplates"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/featureRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                    <include
                        android:id="@+id/featureExport"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"/>

                    <include
                        android:id="@+id/featureStickers"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/featureRow3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                    <include
                        android:id="@+id/featureCustom"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"/>

                    <include
                        android:id="@+id/featureNoAds"
                        layout="@layout/layout_subscriptions_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>

    <!-- ── Sticky footer ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="15dp"
        android:background="@color/white"
        android:paddingTop="15dp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/continueBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_button_gradient_wrap"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btnIdleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/bold"
                android:text="@string/sub_cta_subscribe"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/btnSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/sub_cta_subscribed"
                    android:padding="7dp"
                    android:src="@drawable/ic_done" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/bold"
                    android:text="@string/sub_cta_subscribed"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/manageSubLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:text="@string/sub_manage_link"
            android:textColor="@color/appColor"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/termsOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_of_use"
                android:padding="8dp"
                android:textColor="@color/gray"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="·"
                android:textColor="@color/gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/privacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:padding="8dp"
                android:textColor="@color/gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>