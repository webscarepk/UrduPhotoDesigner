<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    tools:context=".ui.editor.panels.removeBg.BgRemovalFragment">

    <!-- 1. COMPACT HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@drawable/ic_editor_header"
        android:backgroundTint="@color/white"
        android:translationZ="6dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />


        <!-- Floating Undo/Redo Pill -->
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/redoUndo"
            android:weightSum="2"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@id/back"
            app:layout_constraintTop_toTopOf="@id/back"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintEnd_toStartOf="@id/done"
            android:paddingHorizontal="5dp">

            <ImageView
                android:id="@+id/undo"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_bg_round"
                android:backgroundTint="@color/contrast"
                app:tint="@color/black"
                android:src="@drawable/ic_undo"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:id="@+id/redo"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_bg_round"
                android:backgroundTint="@color/contrast"
                app:tint="@color/black"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:src="@drawable/ic_redo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/undo"
                app:layout_constraintTop_toTopOf="parent" />
        </LinearLayout>


        <ImageView
            android:id="@+id/done"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_button_gradient_wrap"
            android:backgroundTint="@color/selection"
            android:padding="8dp"
            android:src="@drawable/ic_done"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/back"
            app:layout_constraintBottom_toBottomOf="@id/back"
            app:tint="@color/black" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. MAXIMUM CANVAS AREA & FLOATING OVERLAYS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/canvasCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:cardPreventCornerOverlap="true"
        app:layout_constraintBottom_toTopOf="@id/quickActionsCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.webscare.urducanvas.common.views.BgRemovalCanvas
                android:id="@+id/imageCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. QUICK ACTIONS TOOLBAR (CARD 1) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/quickActionsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:layout_constraintBottom_toTopOf="@id/selectionToolCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Move -->
            <LinearLayout
                android:id="@+id/btnMove"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/handIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hand"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Move"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Preview -->
            <LinearLayout
                android:id="@+id/btnPreview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/previewIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_show_pass"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Preview"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Invert -->
            <LinearLayout
                android:id="@+id/btnInvert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/invertIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_invert"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Invert"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Clear -->
            <LinearLayout
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/clearIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Clear"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/light_gray" />

            <!-- Add (Green State) -->
            <LinearLayout
                android:id="@+id/btnAdd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/ic_circle"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/addIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/gray" />

            </LinearLayout>

            <!-- Remove (Red State) -->
            <LinearLayout
                android:id="@+id/btnRemove"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@drawable/ic_circle"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/removeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/gray" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. SELECTION TOOL BAR (CARD 2) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/selectionToolCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:layout_constraintBottom_toTopOf="@id/helperCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <!-- AI Subject (Default Active) -->
            <LinearLayout
                android:id="@+id/btnAiSubject"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1.2"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/contrast"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icAiSubject"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_select_subject"
                    app:tint="#2E7D32" />

                <TextView
                    android:id="@+id/tvAiSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI Subject"
                    android:textColor="@color/appColor"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Brush -->
            <LinearLayout
                android:id="@+id/btnBrush"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icBrush"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lasso"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvBrush"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Brush"
                    android:textColor="@color/gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Rectangle -->
            <LinearLayout
                android:id="@+id/btnRect"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icRect"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_rect"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvRect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rectangle"
                    android:textColor="@color/gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ellipse -->
            <LinearLayout
                android:id="@+id/btnEllipse"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icEllipse"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_circle"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvEllipse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ellipse"
                    android:textColor="@color/gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Magic Wand -->
            <LinearLayout
                android:id="@+id/btnMagicWand"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icMagicWand"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_magic_wand"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvMagicWand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Magic Wand"
                    android:textColor="@color/gray"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 5. BOTTOM HELPER CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/helperCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/button_bg_round"
                android:backgroundTint="@color/contrast"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/yellow1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to use"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Use Add (+) to include areas, Remove (−) to erase.\nPinch to zoom, drag to pan around the image."
                    android:textColor="@color/gray"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>