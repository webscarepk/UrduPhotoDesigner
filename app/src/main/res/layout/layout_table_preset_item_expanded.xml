<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPreset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="@color/contrast"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <com.webscare.urducanvas.common.views.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.webscare.urducanvas.common.views.TablePresetPreviewView
            android:id="@+id/tablePreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp" />

    </com.webscare.urducanvas.common.views.SquareFrameLayout>

</com.google.android.material.card.MaterialCardView>
