<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/panel_bg"
    tools:context=".ui.editor.panels.images.ImagesFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.02"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.98"
        android:orientation="vertical" />

    <!-- Drag handle — swipe up = expand, swipe down = collapse -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:src="@drawable/drag_handle_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ COLLAPSED HEADER ════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerCollapsed"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <ImageView
            android:id="@+id/addImage"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_import"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_gravity="center_vertical" />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_search"
            android:layout_gravity="center_vertical" />

        <EditText
            android:id="@+id/searchBar"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:fontFamily="@font/regular"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_gravity="center_vertical"
            android:background="@drawable/button_bg_small"
            android:paddingHorizontal="12dp"
            android:drawablePadding="6dp"
            android:textColorHint="@android:color/darker_gray"
            android:backgroundTint="@color/contrast"
            android:hint="@string/search_here" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/appColor"
            app:tabIndicatorHeight="1dp"
            app:tabPadding="0dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorFullWidth="false"
            app:tabSelectedTextColor="@color/appColor"
            app:tabTextColor="@color/black"
            app:tabRippleColor="@color/contrast" />
    </LinearLayout>

    <!-- ═══ EXPANDED HEADER ════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerExpanded"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <ImageView
            android:id="@+id/addImageExpanded"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_import"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/searchBarExpanded"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:fontFamily="@font/regular"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:background="@drawable/button_bg_small"
            android:paddingHorizontal="12dp"
            android:drawablePadding="6dp"
            android:textColorHint="@android:color/darker_gray"
            android:backgroundTint="@color/contrast"
            android:hint="@string/search_here"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/closeExpanded"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Tab layout for expanded state -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutExpanded"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:visibility="gone"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/appColor"
        app:tabIndicatorHeight="1dp"
        app:tabPadding="0dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/appColor"
        app:tabTextColor="@color/black"
        app:tabRippleColor="@color/contrast"
        app:layout_constraintTop_toBottomOf="@id/headerExpanded"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide" />

    <!-- Content area -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/headerCollapsed"
        app:layout_constraintBottom_toTopOf="@id/selectionToolbar"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide" />

    <!-- ═══ SELECTION TOOLBAR ════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectionToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:text=""
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:fontFamily="@font/regular"
            android:textSize="13sp"
            android:textColor="@color/gray"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/doneSelection"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/doneSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:fontFamily="@font/bold"
            android:textSize="13sp"
            android:textColor="@color/appColor"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/selectedThumbnails"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/selectionCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>