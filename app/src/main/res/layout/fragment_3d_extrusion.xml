<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- Top Segmented Control -->
    <com.webscare.urducanvas.common.views.SegmentedControlView
        android:id="@+id/segmentedControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Subscreen 1: DEPTH ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDepth"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/segmentedControl">

        <com.webscare.urducanvas.common.views.Custom3DSliderView
            android:id="@+id/sliderDepthOnly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/sliderDepthScaleOnly"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.webscare.urducanvas.common.views.Custom3DSliderView
            android:id="@+id/sliderDepthScaleOnly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/sliderDepthOnly"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Subscreen 2: DIRECTION (Snap Pad) ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDirection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/segmentedControl">

        <com.webscare.urducanvas.common.views.Text3DPadView
            android:id="@+id/directionPad"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/directionSlidersContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/directionPad"
            app:layout_constraintTop_toTopOf="@id/directionPad">

            <com.webscare.urducanvas.common.views.Custom3DSliderView
                android:id="@+id/sliderDirectionDepth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.webscare.urducanvas.common.views.Custom3DSliderView
                android:id="@+id/sliderDirectionScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDirectionHelp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/regular"
            android:lineSpacingExtra="2dp"
            android:textColor="#8E94A2"
            android:textSize="10.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/directionPad"
            tools:text="Bottom-right — drag the pad, it snaps to the nine offsets. Centre casts depth straight back with none." />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Subscreen 3: BEVEL ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBevel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/segmentedControl">

        <com.webscare.urducanvas.common.views.Custom3DSliderView
            android:id="@+id/sliderBevelAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/sliderBevelSmoothness"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.webscare.urducanvas.common.views.Custom3DSliderView
            android:id="@+id/sliderBevelSmoothness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/sliderBevelAmount"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
