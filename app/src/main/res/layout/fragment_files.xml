<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    tools:context=".ui.navigation.files.FilesFragment">

    <!-- ── Guides ──────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.95"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95"/>

    <ImageView
        android:id="@+id/back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:backgroundTint="@color/white"
        android:padding="7dp"
        android:background="@drawable/button_bg_round"
        android:src="@drawable/ic_back"
        app:tint="@color/black"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintBottom_toTopOf="@id/searchBar"/>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/bold"
        android:text="@string/my_files"
        android:textColor="@color/black"
        android:textSize="19sp"
        app:layout_constraintStart_toEndOf="@id/back"
        app:layout_constraintTop_toTopOf="@id/back"
        app:layout_constraintBottom_toBottomOf="@id/back"/>

    <!-- ── Import button — shown in normal mode, hidden during selection ──
         Rounded pill with upload icon + dynamic label per tab.
         Hidden on the "All" tab.
    ──────────────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/importBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/button_bg_round_stroke_fill"
        android:drawablePadding="6dp"
        android:fontFamily="@font/medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="Import"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:translationZ="1dp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_download"
        app:drawableTint="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toTopOf="@id/title"/>

    <!-- ── Delete All button — replaces Import in the toolbar during selection ──
         Same pill shape; red tint; hidden by default.
    ──────────────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/deleteAllBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/button_bg_round_stroke_fill"
        android:drawablePadding="6dp"
        android:fontFamily="@font/medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="@string/delete_all"
        android:textColor="@android:color/holo_red_light"
        android:textSize="12sp"
        android:translationZ="1dp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_delete"
        app:drawableTint="@android:color/holo_red_light"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toTopOf="@id/title"/>

    <!-- ── Grid / List toggle ─────────────────────────────────────────── -->
    <ImageView
        android:id="@+id/listStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/button_bg_stroke_fill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:src="@drawable/ic_list_view"
        app:tint="@color/black"
        android:translationZ="1dp"
        app:layout_constraintBottom_toBottomOf="@id/searchBar"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/searchBar"
        app:layout_constraintTop_toTopOf="@id/searchBar"/>

    <!-- ── Search bar ─────────────────────────────────────────────────── -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_bg_stroke_fill"
        android:drawablePadding="12dp"
        android:drawableTint="@color/gray"
        android:fontFamily="@font/regular"
        android:hint="@string/search_projects_files_and_assets"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textSize="12sp"
        android:translationZ="1dp"
        app:drawableEndCompat="@drawable/ic_search"
        app:layout_constraintEnd_toStartOf="@id/listStyle"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/title"/>

    <!-- ── Tab strip ──────────────────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="auto"
        app:tabPadding="0dp"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="4dp"
        app:tabRippleColor="@color/contrast"
        app:tabSelectedTextColor="@color/appColor"
        app:tabTextColor="@color/black"/>

    <!-- ── ViewPager2 ─────────────────────────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"/>

    <!-- ── Fade overlay at the top of the pager ──────────────────────── -->
    <View
        android:id="@+id/topFadeOverlay"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_templates_header_gradient"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewPager"/>

</androidx.constraintlayout.widget.ConstraintLayout>