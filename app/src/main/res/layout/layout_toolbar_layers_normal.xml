<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/layers"
        android:textColor="@color/black"
        android:fontFamily="@font/bold"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!--
        canvasSizeBtn — existing canvas dimensions button.
        Now constrained to end of canvasPanLockBtn (not closePanel directly).
    -->
    <TextView
        android:id="@+id/canvasSizeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1080 × 1920"
        android:textSize="11sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:fontFamily="@font/medium"
        android:background="@drawable/button_bg_dim"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/closePanel" />

    <!-- Shown only when panel is expanded -->
    <ImageView
        android:id="@+id/closePanel"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="8dp"
        android:visibility="gone"
        android:background="@drawable/button_bg_round"
        android:backgroundTint="@color/contrast"
        app:tint="@color/black"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>