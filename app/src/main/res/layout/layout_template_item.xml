<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/gray"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔹 Aspect Ratio Container (KEY PART) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- SHIMMER -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.6"
                app:shimmer_duration="900"
                app:shimmer_colored="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:shimmer_base_color="@color/contrast"
                app:shimmer_highlight_alpha="1.0">

                <!-- IMAGE -->
                <ImageView
                    android:id="@+id/template"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:background="@color/contrast"/>

            </com.facebook.shimmer.ShimmerFrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- PREMIUM BADGE -->
        <ImageView
            android:id="@+id/isPremium"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="6dp"
            android:src="@drawable/ic_premium_icon"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/imageContainer"
            app:layout_constraintEnd_toEndOf="@id/imageContainer"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_rawRes="@raw/loading_gray"
            app:lottie_autoPlay="true"
            android:layout_gravity="end|bottom"
            android:layout_margin="6dp"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            app:lottie_loop="true"
            app:layout_constraintEnd_toEndOf="@id/imageContainer"
            app:layout_constraintBottom_toBottomOf="@id/imageContainer"
            android:padding="6dp"/>

        <!-- DOWNLOAD ICON -->
        <ImageView
            android:id="@+id/download"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="6dp"
            android:padding="6dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_download"
            app:tint="@color/appColor"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/imageContainer"
            app:layout_constraintBottom_toBottomOf="@id/imageContainer"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
