<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_5sdp"
    android:layout_marginBottom="@dimen/_5sdp"
    app:cardBackgroundColor="@color/selection"
    android:maxHeight="@dimen/_140sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.5"
            app:shimmer_duration="1000"
            app:shimmer_base_color="@color/contrast"
            app:shimmer_colored="true"
            app:shimmer_highlight_alpha="1.0">

            <ImageView
                android:id="@+id/template"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_launcher_background"
                android:background="@color/contrast" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/progressBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/appColor"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:layout_gravity="end|bottom"
            android:visibility="gone"
            android:layout_margin="@dimen/_10sdp">
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:layout_marginEnd="@dimen/_5sdp"
                android:indeterminateTint="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28%"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp"
                android:fontFamily="@font/medium"
                android:id="@+id/percentage"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/download"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/_3sdp"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="@dimen/_5sdp"
            app:tint="@color/appColor" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>