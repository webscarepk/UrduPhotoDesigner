<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="70dp"
    android:layout_height="70dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/selection"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/contrast">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.5"
            app:shimmer_duration="700"
app:shimmer_repeat_delay="0"
            app:shimmer_base_color="@color/contrast"
            app:shimmer_colored="true"
            app:shimmer_highlight_alpha="1.0">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_launcher_background"
                android:background="@color/white"
                android:padding="6dp"
                android:scaleType="centerCrop" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:lottie_rawRes="@raw/loading_gray"
            app:lottie_autoPlay="true"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            app:lottie_loop="true"
            android:padding="4dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_premium_icon"
            android:layout_gravity="top|end"
            android:id="@+id/isPremium"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/download"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="6dp"
            app:tint="@color/appColor" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>