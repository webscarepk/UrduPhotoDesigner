<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.templates.TemplatesFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:text="@string/templates"
        android:fontFamily="@font/bold"
        android:textSize="19sp"
        android:textColor="@color/black"
        android:id="@+id/title"/>

    <EditText
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/button_bg_stroke_fill"
        android:fontFamily="@font/regular"
        android:drawableEnd="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="12sp"
        android:hint="@string/search_templates"
        android:translationZ="1dp"
        android:singleLine="true"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:drawableTint="@color/gray"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/filters"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:textColorHint="@color/gray"
        android:textColor="@color/black"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="12dp"/>

    <ImageView
        android:id="@+id/filters"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="@id/searchBar"
        app:layout_constraintBottom_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toEndOf="@id/searchBar"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        android:src="@drawable/ic_filters"
        android:translationZ="1dp"
        android:background="@drawable/button_bg_stroke_fill"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:text="@string/browse_by_size"
        android:fontFamily="@font/bold"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:id="@+id/sizeTitle"/>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="6dp"
        android:id="@+id/sizesRV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="@dimen/_12sdp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/layout_sizes_filter_item"
        app:layout_constraintTop_toBottomOf="@id/sizeTitle"/>

    <androidx.recyclerview.widget.RecyclerView
        android:paddingTop="12dp"
        android:id="@+id/categoriesRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:listitem="@layout/layout_category_row"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/sizesRV"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false"/>

    <View
        android:id="@+id/topFadeOverlay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_templates_header_gradient"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="@id/categoriesRV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/categoryChips"
        android:layout_width="0dp"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:background="@color/contrast"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:singleLine="false"
        app:singleSelection="true"
        android:paddingVertical="23dp"
        android:paddingHorizontal="23dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>