<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.settings.SettingsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        android:outlineSpotShadowColor="@color/shadowColor"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:id="@+id/subscriptionCard"
        android:layout_marginTop="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_subscription_card_bg"
            android:scaleType="centerCrop"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/button_bg_round"
                android:src="@drawable/ic_crown"
                android:padding="7dp"
                android:id="@+id/titleImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:backgroundTint="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urdu_canvas_pro"
                android:textSize="14sp"
                android:fontFamily="@font/bold"
                app:layout_constraintStart_toEndOf="@id/titleImage"
                android:textColor="@color/white"
                android:layout_marginStart="10dp"
                android:id="@+id/subscriptionCardTitle"
                app:layout_constraintBottom_toTopOf="@+id/subscriptionCardSubTitle"
                app:layout_constraintTop_toTopOf="@id/titleImage"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_all_features_and_assets"
                android:textSize="12sp"
                android:fontFamily="@font/regular"
                app:layout_constraintStart_toEndOf="@id/titleImage"
                android:textColor="@color/light_gray"
                android:layout_marginStart="10dp"
                android:id="@+id/subscriptionCardSubTitle"
                app:layout_constraintTop_toBottomOf="@id/subscriptionCardTitle"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_gradient_contrast"
                android:text="@string/upgrade_now"
                android:textColor="@color/white"
                android:paddingVertical="5dp"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:text="@string/settings"
        android:fontFamily="@font/bold"
        android:textSize="19sp"
        android:textColor="@color/black"
        android:id="@+id/title"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/subscriptionCard"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="10dp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/subscriptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subscriptions"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:drawableEndCompat="@drawable/ic_next"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="15dp"/>

            <TextView
                android:id="@+id/preferences"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/preferences"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:drawableEndCompat="@drawable/ic_next"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subscriptions"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/support"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/contact_support"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:drawableEndCompat="@drawable/ic_next"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/preferences"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/help"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/help_centre"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/support"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/terms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/terms_of_use"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/help"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/privacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/terms"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/rate_the_app"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/privacy"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/improve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/help_us_improve"
                android:textColor="@color/black"
                android:fontFamily="@font/medium"
                android:textSize="14sp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:padding="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rate"
                android:layout_marginTop="10dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>