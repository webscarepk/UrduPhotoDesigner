<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.settings.SettingsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:text="@string/settings"
        android:fontFamily="@font/bold"
        android:textSize="19sp"
        android:textColor="@color/black"
        android:id="@+id/title"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:id="@+id/subscriptionLayout">

        <!-- ── Upgrade card (shown when NOT subscribed) ─────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:outlineSpotShadowColor="@color/shadowColor"
            app:cardBackgroundColor="@color/white"
            android:id="@+id/subscriptionCard"
            android:layout_marginTop="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_subscription_card_bg"
                android:scaleType="centerCrop"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/button_bg_round"
                    android:src="@drawable/ic_crown"
                    android:padding="8dp"
                    android:id="@+id/titleImage"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:backgroundTint="@color/white"/>

                <!-- stacked title + subtitle -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/urdu_canvas_pro"
                    android:textSize="14sp"
                    android:fontFamily="@font/bold"
                    app:layout_constraintStart_toEndOf="@id/titleImage"
                    app:layout_constraintEnd_toStartOf="@id/upgradeNow"
                    android:textColor="@color/white"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/subscriptionCardTitle"
                    app:layout_constraintBottom_toTopOf="@+id/subscriptionCardSubTitle"
                    app:layout_constraintTop_toTopOf="@id/titleImage"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_all_features_and_assets"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/regular"
                    app:layout_constraintStart_toEndOf="@id/titleImage"
                    app:layout_constraintEnd_toStartOf="@id/upgradeNow"
                    android:textColor="#D6D6D6"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/subscriptionCardSubTitle"
                    app:layout_constraintTop_toBottomOf="@id/subscriptionCardTitle"
                    app:layout_constraintBottom_toBottomOf="@id/titleImage"/>

                <TextView
                    android:id="@+id/upgradeNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_gradient_contrast"
                    android:text="@string/upgrade_now"
                    android:textColor="@color/white"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Manage card (shown when subscribed) ──────────────────────────
             Compact pill design: left status-color accent bar, small icon
             chip, plan name + status badge inline, a one-line status/date
             detail underneath, and a "Manage ›" link on the right. Colors
             on the accent bar / icon chip / badge are all set dynamically
             per subscription status in SettingsFragment (same status→color
             mapping ManageSubscriptionFragment already uses), not hardcoded
             to "active" green. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:outlineSpotShadowColor="@color/shadowColor"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/currentPlanCard"
            android:visibility="visible"
            android:layout_marginTop="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp">

                <!-- Status-color accent bar, inset slightly from the card's
                     rounded corners so it doesn't poke past them. -->
                <View
                    android:id="@+id/statusAccentBar"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/sub_discount_pill"
                    android:backgroundTint="@color/state_green"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/manageCardIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/button_bg_round"
                    android:backgroundTint="@color/state_green_tint"
                    android:padding="8dp"
                    android:src="@drawable/ic_crown"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/statusAccentBar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/state_green" />

                <!-- Plan name + status badge, on one row -->
                <LinearLayout
                    android:id="@+id/manageCardTitleRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@id/manageCardSubTitle"
                    app:layout_constraintEnd_toStartOf="@id/manage"
                    app:layout_constraintStart_toEndOf="@id/manageCardIcon"
                    app:layout_constraintTop_toTopOf="@id/manageCardIcon"
                    app:layout_constraintVertical_chainStyle="packed">

                    <TextView
                        android:id="@+id/manageCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:includeFontPadding="false"
                        android:text="@string/monthly"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/manageCardStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/sub_discount_pill"
                        android:backgroundTint="@color/state_green_tint"
                        android:fontFamily="@font/bold"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="@string/mng_chip_active"
                        android:textColor="@color/state_green"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/manageCardSubTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/regular"
                    android:includeFontPadding="false"
                    android:textColor="@color/gray"
                    android:textSize="11.5sp"
                    app:layout_constraintBottom_toBottomOf="@id/manageCardIcon"
                    app:layout_constraintEnd_toStartOf="@id/manage"
                    app:layout_constraintStart_toEndOf="@id/manageCardIcon"
                    app:layout_constraintTop_toBottomOf="@id/manageCardTitleRow"
                    tools:text="Renews Aug 1, 2026" />

                <TextView
                    android:id="@+id/manage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/bold"
                    android:text="@string/manage"
                    android:textColor="@color/appColor"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/nextArrow"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    app:tint="@color/gray"
                    android:src="@drawable/ic_next"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:id="@+id/nextArrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/subscriptionLayout"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/bold"
                android:text="@string/general"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/preferences"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_preferences" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/contact_support"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_support" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_privacy" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/rate_the_app"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_rate" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/whatsappChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/join_whatsapp_channel"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_whatsapp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/bold"
                android:text="@string/feedback"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/white"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/improve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/help_us_improve"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_improve" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/requestFeature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/request_for_a_feature"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_feature_request" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/reportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/report_a_bug"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableTint="@color/black"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_bug_report" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/version_1_0_0"
                android:textColor="@color/gray"
                android:fontFamily="@font/regular"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/copyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_2026_webscare_pvt_ltd_all_rights_reserved"
                android:textColor="@color/gray"
                android:fontFamily="@font/regular"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="100dp"/>

        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>