<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.settings.SettingsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:text="@string/settings"
        android:fontFamily="@font/bold"
        android:textSize="19sp"
        android:textColor="@color/black"
        android:id="@+id/title"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:id="@+id/subscriptionLayout">

        <!-- ── Upgrade card (shown when NOT subscribed) ─────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:outlineSpotShadowColor="@color/shadowColor"
            app:cardBackgroundColor="@color/white"
            android:id="@+id/subscriptionCard"
            android:layout_marginTop="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_subscription_card_bg"
                android:scaleType="centerCrop"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/button_bg_round"
                    android:src="@drawable/ic_crown"
                    android:padding="8dp"
                    android:id="@+id/titleImage"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:backgroundTint="@color/white"/>

                <!-- stacked title + subtitle -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/urdu_canvas_pro"
                    android:textSize="14sp"
                    android:fontFamily="@font/bold"
                    app:layout_constraintStart_toEndOf="@id/titleImage"
                    app:layout_constraintEnd_toStartOf="@id/upgradeNow"
                    android:textColor="@color/white"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/subscriptionCardTitle"
                    app:layout_constraintBottom_toTopOf="@+id/subscriptionCardSubTitle"
                    app:layout_constraintTop_toTopOf="@id/titleImage"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_all_features_and_assets"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/regular"
                    app:layout_constraintStart_toEndOf="@id/titleImage"
                    app:layout_constraintEnd_toStartOf="@id/upgradeNow"
                    android:textColor="@color/light_gray"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/subscriptionCardSubTitle"
                    app:layout_constraintTop_toBottomOf="@id/subscriptionCardTitle"
                    app:layout_constraintBottom_toBottomOf="@id/titleImage"/>

                <TextView
                    android:id="@+id/upgradeNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_gradient_contrast"
                    android:text="@string/upgrade_now"
                    android:textColor="@color/white"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Manage card (shown when subscribed) ──────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:outlineSpotShadowColor="@color/shadowColor"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/currentPlanCard"
            android:visibility="gone"
            android:layout_marginTop="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_subscription_card_bg"
                android:scaleType="centerCrop"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/button_bg_round"
                    android:src="@drawable/ic_crown"
                    android:padding="8dp"
                    android:id="@+id/currentTitleImage"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:backgroundTint="@color/white"/>

                <!-- "Current Plan" label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Current Plan"
                    android:textSize="11sp"
                    android:fontFamily="@font/regular"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toEndOf="@id/currentTitleImage"
                    app:layout_constraintEnd_toStartOf="@id/manage"
                    android:textColor="@color/light_gray"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/currentPlanTitle"
                    app:layout_constraintBottom_toTopOf="@+id/manageCardTitle"
                    app:layout_constraintTop_toTopOf="@id/currentTitleImage"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:ignore="DuplicateIds" />

                <!-- Plan name — set dynamically: Monthly / 6 Months / Yearly -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly"
                    android:textSize="17sp"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toEndOf="@id/currentTitleImage"
                    app:layout_constraintEnd_toStartOf="@id/manage"
                    android:textColor="@color/white"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/manageCardTitle"
                    app:layout_constraintTop_toBottomOf="@id/currentPlanTitle"
                    app:layout_constraintBottom_toTopOf="@id/manageCardSubTitle"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/subscribed_amp_unstoppable_new_features_unlocked"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/regular"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toEndOf="@id/currentTitleImage"
                    app:layout_constraintEnd_toStartOf="@id/manage"
                    android:textColor="@color/light_gray"
                    android:layout_marginStart="10dp"
                    android:id="@+id/manageCardSubTitle"
                    app:layout_constraintTop_toBottomOf="@id/manageCardTitle"
                    app:layout_constraintBottom_toBottomOf="@id/currentTitleImage"/>

                <TextView
                    android:id="@+id/manage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_gradient_contrast"
                    android:text="@string/manage"
                    android:textColor="@color/white"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/subscriptionLayout"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/bold"
                android:text="@string/general"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/preferences"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_preferences" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/contact_support"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_support" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_privacy" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/rate_the_app"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_rate" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/whatsappChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/join_whatsapp_channel"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_whatsapp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/bold"
                android:text="@string/feedback"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/improve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/help_us_improve"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_improve" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/requestFeature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/request_for_a_feature"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_feature_request" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@color/white" />

                <TextView
                    android:id="@+id/reportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/medium"
                    android:padding="15dp"
                    android:text="@string/report_a_bug"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_next"
                    app:drawableStartCompat="@drawable/ic_bug_report" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/version_1_0_0"
                android:textColor="@color/gray"
                android:fontFamily="@font/regular"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/copyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_2026_webscare_pvt_ltd_all_rights_reserved"
                android:textColor="@color/gray"
                android:fontFamily="@font/regular"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:paddingBottom="10dp"/>

        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
