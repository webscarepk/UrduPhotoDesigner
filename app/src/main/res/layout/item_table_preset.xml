<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPreset"
    android:layout_width="80dp"
    android:layout_height="72dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/contrast"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/appColor"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Mini Table Preview Thumbnail Frame -->
        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="38dp"
            android:layout_height="28dp"
            android:background="@drawable/edit_bg_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Header Row Preview -->
                <View
                    android:id="@+id/headerPreview"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:background="#E4F3E9" />

                <!-- Row 1 Preview -->
                <View
                    android:id="@+id/row1Preview"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:background="#FFFFFF" />

                <!-- Row 2 Preview -->
                <View
                    android:id="@+id/row2Preview"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:background="#F4F6F8" />
            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tvPresetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="Plain"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
