<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.editor.panels.adjustments.effects.BlurFragment">

    <!-- Highlights -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blurCard"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/blurTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blur"
            android:fontFamily="@font/medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/blurSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="@font/regular"
            app:layout_constraintTop_toTopOf="@id/blurTitle"
            app:layout_constraintBottom_toBottomOf="@id/blurTitle"
            app:layout_constraintStart_toEndOf="@id/blurTitle"
            android:textSize="12sp"
            android:background="@drawable/edit_bg_stroke"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:textColor="@color/black"
            android:layout_marginStart="6dp"/>

        <SeekBar
            android:progressBackgroundTint="@color/light_gray"
            android:id="@+id/blur"
            android:layout_marginTop="3dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blurSize"
            android:thumbTint="@color/appColor"
            android:indeterminateTint="@color/appColor"
            android:progressTint="@color/appColor"
            android:progress="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>