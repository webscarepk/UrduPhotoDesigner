<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.editor.panels.draw.DrawFragment"
    android:background="@drawable/panel_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.04"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.30"
        android:orientation="vertical" />

    <!-- Drag handle -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:src="@drawable/drag_handle_bg"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ COLLAPSED HEADER: reset + done on right ══════════════════════ -->
    <LinearLayout
        android:id="@+id/headerCollapsed"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide">

        <ImageView
            android:id="@+id/reset"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/done"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_done" />

    </LinearLayout>

    <!-- ═══ EXPANDED HEADER: title left · reset + done + close right ═════ -->
    <LinearLayout
        android:id="@+id/headerExpanded"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/draw"
            android:fontFamily="@font/bold"
            android:textSize="16sp"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/resetExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/doneExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_done" />

        <ImageView
            android:id="@+id/closePanel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- Barrier tracks whichever header is visible -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerCollapsed,headerExpanded" />

    <!-- Divider anchored to barrier, not headerCollapsed -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide" />

    <!-- Left: brush sub-tab categories -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/centerGuide"
        android:layout_marginEnd="6dp"
        tools:listitem="@layout/layout_tabs_item"
        tools:itemCount="3" />

    <!-- Right: brush sub-tab content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/centerGuide"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>