<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    tools:context=".ui.editor.panels.draw.DrawFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.96" />

    <!-- Drag handle -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:src="@drawable/drag_handle_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ COLLAPSED HEADER: [addBrush] [TabLayout] [reset] [done] ══════════ -->
    <RelativeLayout
        android:id="@+id/headerCollapsed"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <LinearLayout
            android:id="@+id/tabRowContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Add / Draw Button -->
            <ImageView
                android:id="@+id/addBrush"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:padding="6dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_add_draw_fab" />

            <!-- Search the brush catalog by name. Sits with Add brush, ahead of the
                 mode pill: both are actions on the catalog, the pill is a mode. -->
            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:contentDescription="@string/search_brushes"
                android:padding="5dp"
                android:src="@drawable/ic_search"
                app:tint="@color/gray" />

            <!-- Segmented Switch: Brush / Eraser -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/modeSwitchToolbar"
                android:layout_width="128dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnModeBrush"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_bg_small"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:text="Brush"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnModeEraser"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnModeEraser"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_bg_small"
                    android:backgroundTint="@color/contrast"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:text="Eraser"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnModeBrush"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Horizontal TabLayout: Style, Settings, Color -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/Widget.UrduCanvas.TabLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Full-width 1dp baseline divider -->
        <View
            android:id="@+id/tabBaselineDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- Horizontal ViewPager2 for Style / Settings / Color tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:saveEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCollapsed" />

    <!-- Eraser Panel Container (shown when Eraser is active) -->
    <FrameLayout
        android:id="@+id/eraserContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCollapsed" />

    <!-- Child Fragment Container (ColorPicker / GradientEditor overlay) -->
    <FrameLayout
        android:id="@+id/drawChildContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>