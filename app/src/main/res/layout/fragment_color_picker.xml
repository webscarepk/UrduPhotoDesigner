<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingHorizontal="16dp"
    tools:context=".ui.editor.panels.text.appearance.childs.gradient.ColorPickerFragment">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_done"
        android:padding="6dp"
        android:id="@+id/done"
        app:tint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_picker"
        android:fontFamily="@font/medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/done"
        app:layout_constraintBottom_toBottomOf="@id/done"
        android:textColor="@color/black"
        android:paddingHorizontal="6dp"/>

    <com.webscare.urducanvas.common.views.ColorPickerBar
        android:id="@+id/seekbarHue"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:splitTrack="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/done"
        app:layout_constraintBottom_toTopOf="@id/seekbarAlpha" />

    <TextView
        android:id="@+id/colorCode"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:text="#FF0000"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/regular"
        android:gravity="center"
        android:background="@drawable/edit_bg_stroke"
        android:paddingHorizontal="5dp"
        android:paddingVertical="5dp"
        app:layout_constraintTop_toTopOf="@id/seekbarAlpha"
        app:layout_constraintBottom_toBottomOf="@id/seekbarAlpha"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.webscare.urducanvas.common.views.ColorPickerBar
        android:id="@+id/seekbarAlpha"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:splitTrack="false"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/colorCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seekbarHue"/>


</androidx.constraintlayout.widget.ConstraintLayout>