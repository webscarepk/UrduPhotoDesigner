<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.editor.panels.objects.ObjectsFragment"
    android:background="@drawable/panel_bg">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.01"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.99"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.02"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"
        android:orientation="vertical"
        android:id="@+id/centerGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.98"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="38dp"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toTopOf="@id/topGuide">

        <ImageView
            android:id="@+id/addImage"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_import"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_gravity="center_vertical"/>

        <ImageView
            android:id="@+id/searchIcon"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="8dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_search"
            android:layout_gravity="center_vertical"/>

        <EditText
            android:visibility="gone"
            android:id="@+id/searchBar"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/black"
            android:fontFamily="@font/regular"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_gravity="center_vertical"
            android:background="@drawable/button_bg_small"
            android:paddingHorizontal="12dp"
            android:drawablePadding="6dp"
            android:textColorHint="@android:color/darker_gray"
            android:backgroundTint="@color/contrast"
            android:hint="@string/search_here"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/appColor"
            app:tabIndicatorHeight="1dp"
            app:tabPadding="0dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorFullWidth="false"
            app:tabSelectedTextColor="@color/appColor"
            app:tabTextColor="@color/black"
            app:tabRippleColor="@color/contrast"/>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:layout_marginTop="6dp"
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide" />
</androidx.constraintlayout.widget.ConstraintLayout>