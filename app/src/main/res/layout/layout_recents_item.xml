<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginEnd="@dimen/_10sdp"
    android:id="@+id/tabRoot">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/thumbnailCard">
        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@mipmap/ic_launcher_round"
            android:id="@+id/thumbnail"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/untitled_design"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp"
        android:fontFamily="@font/regular"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@id/thumbnailCard"
        app:layout_constraintTop_toTopOf="@id/thumbnailCard"
        app:layout_constraintBottom_toTopOf="@id/date"
        android:id="@+id/title"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_10_02_2025"
        android:textColor="@color/gray"
        android:textSize="@dimen/_10sdp"
        android:fontFamily="@font/regular"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@id/thumbnailCard"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/size"
        android:id="@+id/date"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_6_mb"
        android:textColor="@color/gray"
        android:textSize="@dimen/_10sdp"
        android:fontFamily="@font/regular"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@id/thumbnailCard"
        app:layout_constraintTop_toBottomOf="@id/date"
        app:layout_constraintBottom_toBottomOf="@id/thumbnailCard"
        android:id="@+id/size"/>

    <ImageView
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="@id/thumbnailCard"
        app:layout_constraintBottom_toBottomOf="@id/thumbnailCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_options"
        android:id="@+id/options"/>
</androidx.constraintlayout.widget.ConstraintLayout>