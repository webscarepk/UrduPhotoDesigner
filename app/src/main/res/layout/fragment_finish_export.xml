<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.editor.export.FinishExportFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <ImageView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/topGuide" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/bold"
        android:text="@string/export_complete"
        android:textColor="@color/black"
        android:textSize="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="@id/back"
        app:layout_constraintStart_toEndOf="@id/back"
        app:layout_constraintTop_toTopOf="@id/back" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnExportAnother"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:paddingBottom="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/done"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/button_bg_round"
                android:backgroundTint="@color/contrast"
                android:padding="@dimen/_15sdp"
                android:src="@drawable/ic_done"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/appColor" />

            <TextView
                android:id="@+id/successMessage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/medium"
                android:text="@string/export_successful"
                android:textColor="@color/black"
                android:textSize="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/done" />

            <TextView
                android:id="@+id/subTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:text="@string/your_file_has_been_exported_and_is_ready_to_use"
                android:textColor="@color/gray"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/successMessage" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/previewCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_15sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subTitle"
                app:strokeColor="@color/contrast"
                app:strokeWidth="@dimen/_1sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/previewImage"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_150sdp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_150sdp"
                        android:alpha="0.4"
                        android:background="@color/black"
                        app:layout_constraintBottom_toBottomOf="@id/previewImage"
                        app:layout_constraintEnd_toEndOf="@id/previewImage"
                        app:layout_constraintStart_toStartOf="@id/previewImage"
                        app:layout_constraintTop_toTopOf="@id/previewImage" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@id/previewImage"
                        app:layout_constraintEnd_toEndOf="@id/previewImage"
                        app:layout_constraintStart_toStartOf="@id/previewImage"
                        app:layout_constraintTop_toTopOf="@id/previewImage">

                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_format"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/fileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/bold"
                            android:text="@string/export_1753699627928_png"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/icon" />

                        <TextView
                            android:id="@+id/fileType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:text="@string/png_file"
                            android:textColor="@color/gray"
                            android:textSize="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/fileName" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        android:id="@+id/exportPreviewProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/previewImage"
                        app:layout_constraintEnd_toEndOf="@id/previewImage"
                        app:layout_constraintStart_toStartOf="@id/previewImage"
                        app:layout_constraintTop_toTopOf="@id/previewImage" />

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_margin="@dimen/_10sdp"
                        android:background="@drawable/button_bg"
                        android:backgroundTint="@color/contrast"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/ic_show_pass"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fileDetailsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/card_bg"
                android:padding="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/previewCard">

                <TextView
                    android:id="@+id/fileDetailsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="@string/file_details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/fileNameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/medium"
                    android:text="@string/file_name"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fileDetailsTitle" />

                <TextView
                    android:id="@+id/fileNameDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:lines="1"
                    android:singleLine="true"
                    android:text="@string/export_1753699627928_png"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="@id/fileNameTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileNameTitle" />

                <TextView
                    android:id="@+id/fileSizeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:text="@string/file_size"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/fileNameTitle" />

                <TextView
                    android:id="@+id/fileSizeDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:lines="1"
                    android:singleLine="true"
                    android:text="@string/_2_5_mb"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="@id/fileSizeTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileSizeTitle" />

                <TextView
                    android:id="@+id/fileResolutionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/medium"
                    android:text="@string/resolution"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="@id/fileNameTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileNameDetail" />

                <TextView
                    android:id="@+id/fileResolutionDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:lines="1"
                    android:singleLine="true"
                    android:text="@string/_1920_1080"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="@id/fileResolutionTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileResolutionTitle" />

                <TextView
                    android:id="@+id/fileQualityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:text="@string/quality"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/fileResolutionTitle" />

                <TextView
                    android:id="@+id/fileQualityDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:lines="1"
                    android:singleLine="true"
                    android:text="@string/_1920_1080"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="@id/fileQualityTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileQualityTitle" />

                <View
                    android:id="@+id/view5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/contrast"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fileResolutionDetail" />

                <TextView
                    android:id="@+id/fileLocationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/medium"
                    android:text="@string/file_location"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view5" />

                <TextView
                    android:id="@+id/fileLocationDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/button_bg"
                    android:backgroundTint="@color/contrast"
                    android:drawableTint="@color/black"
                    android:ellipsize="end"
                    android:fontFamily="@font/medium"
                    android:gravity="start"
                    android:lines="1"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:singleLine="true"
                    android:text="@string/storage_emulated_0_download_export_1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    app:drawableEndCompat="@drawable/ic_copy"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/fileLocationTitle"
                    app:layout_constraintTop_toBottomOf="@id/fileLocationTitle" />

                <TextView
                    android:id="@+id/exportDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/medium"
                    android:text="@string/exported_on_jul_28_2025_03_47_am"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fileLocationDetail" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quickActionsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/card_bg"
                android:padding="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fileDetailsCard">

                <TextView
                    android:id="@+id/quickActionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="@string/quick_actions"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/card_bg"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_12sdp"
                    android:text="@string/share"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:drawableTint="@color/black"
                    app:drawableTopCompat="@drawable/ic_share"
                    app:layout_constraintEnd_toStartOf="@id/save"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/quickActionTitle" />

                <TextView
                    android:id="@+id/save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/card_bg"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_12sdp"
                    android:text="@string/save"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:drawableTint="@color/black"
                    app:drawableTopCompat="@drawable/ic_save"
                    app:layout_constraintBottom_toBottomOf="@id/share"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/share"
                    app:layout_constraintTop_toTopOf="@id/share" />

                <TextView
                    android:id="@+id/open"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/card_bg"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_12sdp"
                    android:text="@string/open"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:drawableTint="@color/black"
                    app:drawableTopCompat="@drawable/ic_open"
                    app:layout_constraintEnd_toStartOf="@id/preview2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/share" />

                <TextView
                    android:id="@+id/preview2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/card_bg"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_12sdp"
                    android:text="@string/preview"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:drawableTint="@color/black"
                    app:drawableTopCompat="@drawable/ic_show_pass"
                    app:layout_constraintBottom_toBottomOf="@id/open"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/open"
                    app:layout_constraintTop_toTopOf="@id/open" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/card_bg_selected"
                android:padding="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/quickActionsCard">

                <ImageView
                    android:id="@+id/tipIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_bg_round"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_done_stroke"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/exportTipTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/bold"
                    android:text="@string/export_tips"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintBottom_toBottomOf="@id/tipIcon"
                    app:layout_constraintStart_toEndOf="@id/tipIcon"
                    app:layout_constraintTop_toTopOf="@id/tipIcon" />

                <TextView
                    android:id="@+id/tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/medium"
                    android:lineHeight="@dimen/_12sdp"
                    android:text="@string/your_file_has_been_optimized_for_the_selected_quality_and_format_you_can_find_it_in_your_downloads_folder_or_use_the_path_shown_above"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/exportTipTitle"
                    app:layout_constraintTop_toBottomOf="@id/exportTipTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Reset Button -->
    <TextView
        android:id="@+id/btnExportAnother"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:text="@string/export_another"
        android:textColor="@color/black"
        android:gravity="center"
        android:fontFamily="@font/medium"
        android:textSize="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_5sdp"
        android:background="@drawable/card_bg"
        app:drawableStartCompat="@drawable/ic_refresh"
        app:drawableTint="@color/gray"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/centerGuide"
        app:layout_constraintBottom_toTopOf="@id/bottomGuide"
        android:layout_marginTop="@dimen/_10sdp" />

    <!-- Export Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backToHome"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:text="@string/go_home"
        android:textColor="@android:color/white"
        android:gravity="center"
        app:backgroundTint="@color/appColor"
        android:layout_marginStart="@dimen/_10sdp"
        android:background="@drawable/button_bg"
        app:cornerRadius="8dp"
        android:fontFamily="@font/medium"
        android:textSize="@dimen/_10sdp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/btnExportAnother"
        app:layout_constraintStart_toEndOf="@id/btnExportAnother"
        app:layout_constraintEnd_toStartOf="@id/endGuide" />
</androidx.constraintlayout.widget.ConstraintLayout>