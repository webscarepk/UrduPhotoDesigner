<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/tabTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fontFamily="@font/regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/tab_unselected_text"
        android:textSize="13sp" />

    <View
        android:id="@+id/tabDot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_alignTop="@id/tabTitle"
        android:layout_alignEnd="@id/tabTitle"
        android:layout_marginTop="-2dp"
        android:layout_marginEnd="-4dp"
        android:background="@drawable/bg_tab_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/tabIndicator"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/tabTitle"
        android:layout_alignEnd="@id/tabTitle"
        android:background="@drawable/bg_tab_indicator_rounded"
        android:visibility="gone" />

</RelativeLayout>
