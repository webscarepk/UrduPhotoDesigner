<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.editor.panels.adjustments.AdvancedAdjustmentsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Highlights -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/highlightsCard"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sharpnessCard"
            app:layout_constraintBottom_toTopOf="@id/clarityCard">

            <TextView
                android:id="@+id/highlightsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/highlights"
                android:fontFamily="@font/medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/highlightsSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/regular"
                app:layout_constraintTop_toTopOf="@id/highlightsTitle"
                app:layout_constraintBottom_toBottomOf="@id/highlightsTitle"
                app:layout_constraintStart_toEndOf="@id/highlightsTitle"
                android:textSize="12sp"
                android:background="@drawable/edit_bg_stroke"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>

            <SeekBar
                android:id="@+id/highlights"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/highlightsSize"
                android:thumbTint="@color/appColor"
                android:indeterminateTint="@color/appColor"
                android:progressTint="@color/appColor"
                android:progress="50"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sharpness -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sharpnessCard"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/highlightsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/clarityCard">

            <TextView
                android:id="@+id/sharpnessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sharpness"
                android:fontFamily="@font/medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/sharpnessSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:fontFamily="@font/regular"
                app:layout_constraintTop_toTopOf="@id/sharpnessTitle"
                app:layout_constraintBottom_toBottomOf="@id/sharpnessTitle"
                app:layout_constraintStart_toEndOf="@id/sharpnessTitle"
                android:textSize="12sp"
                android:background="@drawable/edit_bg_stroke"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>

            <SeekBar
                android:id="@+id/sharpness"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sharpnessSize"
                android:thumbTint="@color/appColor"
                android:indeterminateTint="@color/appColor"
                android:progressTint="@color/appColor"
                android:progress="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Clarity -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clarityCard"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/highlightsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/fadeCard">

            <TextView
                android:id="@+id/clarityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clarity"
                android:fontFamily="@font/medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/claritySize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/regular"
                app:layout_constraintTop_toTopOf="@id/clarityTitle"
                app:layout_constraintBottom_toBottomOf="@id/clarityTitle"
                app:layout_constraintStart_toEndOf="@id/clarityTitle"
                android:textSize="12sp"
                android:background="@drawable/edit_bg_stroke"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>

            <SeekBar
                android:id="@+id/clarity"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/claritySize"
                android:thumbTint="@color/appColor"
                android:indeterminateTint="@color/appColor"
                android:progressTint="@color/appColor"
                android:progress="50"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Fade / Vignette -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fadeCard"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/sharpnessCard"
            app:layout_constraintStart_toEndOf="@id/clarityCard"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/fadeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fade"
                android:fontFamily="@font/medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/fadeSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:fontFamily="@font/regular"
                app:layout_constraintTop_toTopOf="@id/fadeTitle"
                app:layout_constraintBottom_toBottomOf="@id/fadeTitle"
                app:layout_constraintStart_toEndOf="@id/fadeTitle"
                android:textSize="12sp"
                android:background="@drawable/edit_bg_stroke"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>

            <SeekBar
                android:id="@+id/fade"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fadeSize"
                android:thumbTint="@color/appColor"
                android:indeterminateTint="@color/appColor"
                android:progressTint="@color/appColor"
                android:progress="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
