<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.navigation.settings.ManageSubscriptionFragment">

    <!-- ── Plain toolbar ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sub_chevron_left"
            app:tint="@color/black"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/bold"
            android:text="@string/mng_title"
            android:textColor="@color/black"
            android:textSize="17sp" />
    </LinearLayout>

    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- ── Status banner card ─────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/bannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/contrast"
                android:orientation="vertical"
                android:padding="18dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/sub_chip_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="9dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <View
                            android:id="@+id/chipDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/sub_dot" />

                        <TextView
                            android:id="@+id/chipText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:fontFamily="@font/bold"
                            android:text="@string/mng_chip_active"
                            android:textSize="12sp"
                            tools:textColor="@color/state_green" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/iconBox"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/sub_icon_box">

                        <ImageView
                            android:id="@+id/stateIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sub_state_refresh"
                            android:contentDescription="@string/mng_title" />
                    </FrameLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/bannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/bold"
                    android:text="@string/mng_title_active"
                    android:textColor="@color/sub_price_text"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/bannerDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/mng_detail_active"
                    android:textColor="@color/sub_banner_detail"
                    android:textSize="13.5sp" />

                <!-- no-purchase mono readout -->
                <LinearLayout
                    android:id="@+id/monoBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/sub_mono_box"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/mng_mono_query"
                        android:textColor="@color/sub_mono_text"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/mng_mono_comment"
                        android:textColor="@color/sub_mono_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- real Billing signals -->
                <LinearLayout
                    android:id="@+id/signalsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/sub_signals_box"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="9dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:letterSpacing="0.07"
                        android:paddingTop="10dp"
                        android:paddingBottom="2dp"
                        android:text="@string/mng_signals_header"
                        android:textAllCaps="true"
                        android:textColor="@color/gray"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/signalRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- indeterminate (pending) bar -->
                <FrameLayout
                    android:id="@+id/indeterminateTrack"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/sub_indeterminate_track"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:visibility="gone">

                    <View
                        android:id="@+id/indeterminateBar"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/sub_indeterminate_bar" />
                </FrameLayout>

                <!-- acknowledged-good row -->
                <LinearLayout
                    android:id="@+id/ackGoodRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sub_check"
                        app:tint="@color/sub_signal_good"
                        android:contentDescription="@string/mng_ack_good" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/mng_ack_good"
                        android:textColor="@color/sub_signal_good"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- acknowledged-warning box -->
                <TextView
                    android:id="@+id/ackWarnBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sub_ackwarn_box"
                    android:fontFamily="@font/regular"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/mng_ack_warn"
                    android:textColor="@color/sub_ackwarn_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Quick links ────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/moreOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/selection"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/openInPlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_sub_play" android:contentDescription="@string/mng_open_in_play" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:fontFamily="@font/medium" android:text="@string/mng_open_in_play"
                        android:textColor="@color/sub_quicklink_text" android:textSize="14sp" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_sub_chevron_right" android:contentDescription="@null" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/white" />

                <LinearLayout
                    android:id="@+id/restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_sub_restore" android:contentDescription="@string/mng_restore" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:fontFamily="@font/medium" android:text="@string/mng_restore"
                        android:textColor="@color/sub_quicklink_text" android:textSize="14sp" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_sub_chevron_right" android:contentDescription="@null" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/white" />

                <LinearLayout
                    android:id="@+id/helpBilling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_sub_help" android:contentDescription="@string/mng_help_billing" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:fontFamily="@font/medium" android:text="@string/mng_help_billing"
                        android:textColor="@color/sub_quicklink_text" android:textSize="14sp" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_sub_chevron_right" android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Primary / secondary CTAs ───────────────────────────────── -->
            <TextView
                android:id="@+id/primaryBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ic_button_gradient_wrap"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/mng_cta_change_plan"
                android:textColor="@color/white"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/secondaryBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/sub_secondary_btn"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="@string/mng_cta_manage_play"
                android:textColor="@color/sub_secondary_btn_text"
                android:textSize="14.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
