<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.home.HomeFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/ic_home_header"
        android:id="@+id/header"
        android:translationZ="12dp"
        android:padding="19dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_app_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile"
            app:layout_constraintBottom_toBottomOf="@id/profile"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_bg_round"
            android:src="@drawable/ic_profile"
            android:backgroundTint="@color/white"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/profile"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_bg_round"
            android:src="@drawable/ic_notifications"
            android:backgroundTint="@color/white"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/profile"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/notifications"/>

        <EditText
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/button_bg_stroke_fill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/regular"
            android:drawableEnd="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textSize="15sp"
            android:hint="@string/search_here"
            android:textColorHint="@color/gray"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/profile"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:id="@+id/create"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/blankCanvas"
            app:layout_constraintTop_toBottomOf="@id/searchBar"
            android:layout_marginTop="19dp"
            android:layout_marginStart="12dp"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/button_bg"
            android:backgroundTint="@color/white"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_create"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_photo"
                android:fontFamily="@font/bold"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:id="@+id/blankCanvas"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/button_bg"
            app:layout_constraintStart_toEndOf="@id/create"
            app:layout_constraintTop_toTopOf="@id/create"
            app:layout_constraintBottom_toBottomOf="@id/create"
            app:layout_constraintEnd_toStartOf="@id/templates"
            android:backgroundTint="@color/white"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_blank_canvas"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blank_canvas"
                android:fontFamily="@font/bold"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:id="@+id/templates"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/blankCanvas"
            app:layout_constraintTop_toTopOf="@id/create"
            app:layout_constraintBottom_toBottomOf="@id/create"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/button_bg"
            android:backgroundTint="@color/white"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_templates_mixed"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/templates"
                android:fontFamily="@font/bold"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_custom_fonts_assets_and_imports_in_files_tab"
            android:fontFamily="@font/bold"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/create"
            android:layout_marginTop="19dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingHorizontal="19dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/recentProjects">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_projects"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/recentTitle"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/recentTitle"
                    app:layout_constraintBottom_toBottomOf="@id/recentTitle"
                    android:background="?selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/see_all"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:paddingVertical="6dp"
                        app:layout_constraintEnd_toStartOf="@id/more1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="6dp"
                        android:id="@+id/recentSeeAll"/>

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_dropdown"
                        android:id="@+id/more1"
                        android:rotation="270"
                        app:tint="@color/gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentsRV"
                android:layout_width="0dp"
                android:paddingHorizontal="12dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/recentProjects"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/layout_recents_item"
                android:orientation="horizontal"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>