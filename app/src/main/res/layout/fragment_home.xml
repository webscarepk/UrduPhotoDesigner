<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contrast"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.navigation.home.HomeFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02"
        android:id="@+id/topGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="horizontal"
        android:id="@+id/bottomGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/startGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/endGuide"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:outlineSpotShadowColor="@color/shadowColor"
        android:elevation="10dp"
        android:background="@drawable/bg_home_header"
        android:backgroundTint="@color/contrast"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Brand Title & Subtitle Container -->
        <LinearLayout
            android:id="@+id/brandLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/app_name"
                android:fontFamily="@font/bold"
                android:textSize="24sp"
                android:textColor="@color/appColor" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_beautiful_in_urdu"
                android:fontFamily="@font/regular"
                android:textSize="13sp"
                android:textColor="@color/gray"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Subscription Pro Diamond Icon (Hidden to match Image 4) -->
        <ImageView
            android:id="@+id/subscriptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_subscriptions"
            android:visibility="visible"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.webscare.urducanvas.common.views.RippleView
            android:id="@+id/subscriptionRipple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="@id/subscriptions"
            app:layout_constraintStart_toStartOf="@id/subscriptions"
            app:layout_constraintTop_toTopOf="@id/subscriptions"
            app:layout_constraintBottom_toBottomOf="@id/subscriptions" />

        <!-- Search Bar (Clean, no shadow, no filter icon) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/searchContainer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_home_search_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandLayout">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:layout_marginStart="14dp"
                app:tint="@color/gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/regular"
                android:hint="@string/search_templates_fonts_and_assets"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/searchIcon"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3 Main CTA Columns Container -->
        <LinearLayout
            android:id="@+id/ctaContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:baselineAligned="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchContainer">

            <!-- CTA 1: Add Photo -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cta_item_ripple">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/selection"
                        android:background="@drawable/bg_cta_circle">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cta_add_photo" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:text="@string/upload_photo"
                        android:fontFamily="@font/bold"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upload_and_edit"
                        android:fontFamily="@font/regular"
                        android:textSize="11sp"
                        android:textColor="@color/gray"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>

            <!-- Vertical Divider 1 -->
            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:background="#E8ECE9" />

            <!-- CTA 2: New Canvas -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/blankCanvas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cta_item_ripple">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/selection"
                        android:background="@drawable/bg_cta_circle">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cta_new_canvas" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:text="@string/blank_canvas"
                        android:fontFamily="@font/bold"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_designing"
                        android:fontFamily="@font/regular"
                        android:textSize="11sp"
                        android:textColor="@color/gray"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>

            <!-- Vertical Divider 2 -->
            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:background="#E8ECE9" />

            <!-- CTA 3: Templates -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/templates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_cta_item_ripple">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/selection"
                        android:background="@drawable/bg_cta_circle">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cta_templates" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:text="@string/browse_templates"
                        android:fontFamily="@font/bold"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/explore_ready_made"
                        android:fontFamily="@font/regular"
                        android:textSize="11sp"
                        android:textColor="@color/gray"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Manage Fonts & Assets Strip -->
        <LinearLayout
            android:id="@+id/fileText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ctaContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_custom_fonts_assets_and_imports_in_files_tab"
                android:fontFamily="@font/regular"
                android:textSize="12sp"
                android:textColor="@color/gray" />

            <TextView
                android:id="@+id/fileTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/bold"
                android:text="@string/filesTab"
                android:textColor="@color/appColor"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scrollbars="none"
        android:paddingTop="16dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingHorizontal="19dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/recentProjects">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_projects"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/recentTitle"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/recentSeeAllBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/recentTitle"
                    app:layout_constraintBottom_toBottomOf="@id/recentTitle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/see_all"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:paddingVertical="6dp"
                        app:layout_constraintEnd_toStartOf="@id/more1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="6dp"
                        android:id="@+id/recentSeeAll"/>

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_dropdown"
                        android:id="@+id/more1"
                        android:rotation="270"
                        app:tint="@color/gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentsRV"
                android:layout_width="0dp"
                android:paddingHorizontal="12dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/recentProjects"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/layout_recents_item"
                android:orientation="horizontal"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingHorizontal="19dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recentsRV"
                android:id="@+id/popularTemplate">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/popular_templates"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/popularTemplateTitle"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/popularTemplateSeeAllBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/popularTemplateTitle"
                    app:layout_constraintBottom_toBottomOf="@id/popularTemplateTitle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/see_all"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:paddingVertical="6dp"
                        app:layout_constraintEnd_toStartOf="@id/more3"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="6dp"
                        android:id="@+id/popularTemplateSeeAll"/>

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_dropdown"
                        android:id="@+id/more3"
                        android:rotation="270"
                        app:tint="@color/gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/popularTemplateRV"
                android:layout_width="0dp"
                android:paddingHorizontal="12dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/popularTemplate"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/layout_template_popular"
                android:orientation="horizontal"/>

            <com.webscare.ads.WebsCareNativeView
                android:id="@+id/home_native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:webscare_native_size="small"
                app:webscare_show_shimmer="true"
                app:layout_constraintTop_toBottomOf="@id/popularTemplateRV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingHorizontal="19dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_native_ad"
                android:id="@+id/popularFonts">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/popular_fonts"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/fontsTitle"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/popularFontsSeeAllBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/fontsTitle"
                    app:layout_constraintBottom_toBottomOf="@id/fontsTitle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/see_all"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:paddingVertical="6dp"
                        app:layout_constraintEnd_toStartOf="@id/more2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="6dp"
                        android:id="@+id/fontsSeeAll"/>

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_dropdown"
                        android:id="@+id/more2"
                        android:rotation="270"
                        app:tint="@color/gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fontsRV"
                android:layout_width="0dp"
                android:paddingHorizontal="12dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/popularFonts"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/layout_popular_font_item"
                android:orientation="horizontal"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trendsRV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/layout_category_row"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="vertical"
                android:paddingBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/fontsRV"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipToPadding="false"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>


    <!-- Loading skeleton (shown during initial fetch) -->
    <include
        android:id="@+id/loadingState"
        layout="@layout/layout_home_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error / empty state -->
    <include
        android:id="@+id/errorState"
        layout="@layout/layout_home_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>