<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/brushCard"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/contrast"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/appColor"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/brushPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/contrast"
            android:contentDescription="Brush Style Preview"
            android:padding="6dp"
            android:scaleType="fitCenter" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
