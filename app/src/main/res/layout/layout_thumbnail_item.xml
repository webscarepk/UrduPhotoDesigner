<?xml version="1.0" encoding="utf-8"?>
<!--
    Dedicated thumbnail item for the selection toolbar strip.
    Small square card with the image/emoji preview + a close icon
    in the top-right corner to deselect.
    Kept intentionally minimal — no shimmer, no premium badge, no loading anim.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_marginEnd="6dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="8dp"
        android:layout_alignParentBottom="true"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/contrast">

        <ImageView
            android:id="@+id/thumbImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="4dp" />
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/thumbClose"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:translationZ="3dp"
        android:layout_margin="2dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_close"
        android:background="@drawable/button_bg_round"
        android:padding="4dp"
        app:tint="@color/black" />
</RelativeLayout>