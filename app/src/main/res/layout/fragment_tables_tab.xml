<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- ═══ SINGLE LINE HEADER: Title & Subtitle Left · Tick Right ═══ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGridReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="3 × 3"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGridSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/regular"
                android:text="rows × columns · RTL"
                android:textColor="#8E94A2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInsertTable"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="6dp"
            android:src="@drawable/ic_done"
            app:tint="@color/black" />

    </RelativeLayout>

    <!-- ═══ FULL-WIDTH CONTRAST GRID CONTAINER ═══ -->
    <GridLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="10"
        android:rowCount="10"
        android:background="@drawable/button_bg_small"
        android:backgroundTint="@color/contrast"
        android:padding="4dp" />

</LinearLayout>
