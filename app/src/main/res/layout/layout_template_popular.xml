<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="80dp"
    android:layout_height="120dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/contrast"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.5"
            app:shimmer_base_color="@color/contrast"
            app:shimmer_colored="true"
            app:shimmer_duration="700"
            app:shimmer_highlight_alpha="@dimen/shimmer_highlight_alpha"
            app:shimmer_repeat_delay="0">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/contrast"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />

        </com.facebook.shimmer.ShimmerFrameLayout>

