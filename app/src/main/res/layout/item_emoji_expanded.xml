<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="10dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="0dp"
    app:cardForegroundColor="@android:color/transparent">

    <!--
        app:cardForegroundColor="@android:color/transparent" removes the
        MaterialCardView internal foreground scrim that was tinting the content
        and causing the dim/lower-alpha appearance on emoji.

        AppCompatTextView instead of TextView — same as collapsed item which
        renders emoji correctly. AppCompatTextView has better emoji fallback
        handling via EmojiCompat.

        fontFamily kept — same as collapsed item. If collapsed shows correctly
        with symbols font, expanded should too now that the card scrim is gone.
    -->
    <com.webscare.urducanvas.common.views.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/emojiText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="40sp"
            android:textColor="@color/black"
            android:fontFamily="@font/symbols"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/selection"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_unselected_radio"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="3dp"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_gray" />

    </com.webscare.urducanvas.common.views.SquareFrameLayout>

</com.google.android.material.card.MaterialCardView>