<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    tools:context=".ui.editor.panels.table.TablesParentFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.04"
        android:orientation="vertical" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"
        android:orientation="vertical" />

    <!-- Drag handle -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:src="@drawable/drag_handle_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ 1. COLLAPSED STYLES HEADER (Styles Mode) ═══════════════════════ -->
    <RelativeLayout
        android:id="@+id/headerCollapsed"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <LinearLayout
            android:id="@+id/tabRowContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="8dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                app:tint="@color/black"
                android:src="@drawable/ic_search"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_5sdp" />

            <ImageView
                android:id="@+id/btnGridMode"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="7dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                app:tint="@color/black"
                android:src="@drawable/ic_grid"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_5sdp" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/Widget.UrduCanvas.TabLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Full-width 1dp baseline divider -->
        <View
            android:id="@+id/tabBaselineDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- ═══ 2. COLLAPSED GRID HEADER (Custom Grid Mode) ════════════════════ -->
    <RelativeLayout
        android:id="@+id/gridHeaderCollapsed"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/backToStylesCollapsed"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/button_bg_round"
                android:backgroundTint="@color/contrast"
                android:padding="7dp"
                android:src="@drawable/ic_back"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvGridTitleCollapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/bold"
                android:text="Custom Grid"
                android:textColor="@color/black"
                android:textSize="15sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- ═══ 3. EXPANDED STYLES HEADER (Styles Mode) ═════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerExpanded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tables"
            android:fontFamily="@font/bold"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnGridModeExpanded" />

        <ImageView
            android:id="@+id/btnGridModeExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/closeExpanded"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_grid" />

        <ImageView
            android:id="@+id/closeExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            app:tint="@color/black"
            android:src="@drawable/ic_close" />

        <EditText
            android:id="@+id/searchBarExpanded"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:textColor="@color/black"
            android:fontFamily="@font/regular"
            android:textSize="12sp"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:background="@drawable/button_bg_small"
            android:paddingHorizontal="12dp"
            android:drawablePadding="6dp"
            android:textColorHint="@android:color/darker_gray"
            android:backgroundTint="@color/contrast"
            android:hint="@string/search_here"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/closeExpanded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tab layout for expanded state (Styles Mode only) -->
    <RelativeLayout
        android:id="@+id/tabExpandedContainer"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerExpanded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutExpanded"
            style="@style/Widget.UrduCanvas.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:tabIndicatorFullWidth="false"
            app:tabSelectedTextColor="@color/appColor"
            app:tabTextColor="@color/black"
            app:tabRippleColor="@color/contrast" />

        <!-- Full-width 1dp baseline divider -->
        <View
            android:id="@+id/tabBaselineDividerExpanded"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- ═══ 4. EXPANDED GRID HEADER (Custom Grid Mode) ═════════════════════ -->
    <RelativeLayout
        android:id="@+id/gridHeaderExpanded"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <ImageView
            android:id="@+id/backToStylesExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="7dp"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvGridTitleExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/backToStylesExpanded"
            android:fontFamily="@font/bold"
            android:text="Custom Grid"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/closeExpandedGrid"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/black" />

    </RelativeLayout>

    <!--
        BARRIER — sits at the bottom edge of whichever header is currently visible.
        fragmentContainer constrains its top to this barrier always.
    -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerCollapsed,gridHeaderCollapsed,headerExpanded,tabExpandedContainer,gridHeaderExpanded" />

    <!-- Content area -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
