<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="46dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- The box is sized by the adapter so three rows always fit the panel. -->
    <FrameLayout
        android:id="@+id/surfaceBox"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_3d_preset_unselected">

        <View
            android:id="@+id/surfaceBall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="6dp" />

        <!-- Small unfilled tune glyph over the selected swatch. It sits on its own dim
             disc so it stays readable over a pale finish without tinting the preview. -->
        <ImageView
            android:id="@+id/ivEdit"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_swatch_edit_disc"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_tune"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvSurfaceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/regular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#5F6368"
        android:textSize="9sp"
        tools:text="Matte" />

</LinearLayout>
