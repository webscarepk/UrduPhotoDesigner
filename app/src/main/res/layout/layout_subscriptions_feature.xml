<?xml version="1.0" encoding="utf-8"?>
<!--
  One cell of the 2x2 feature grid on the subscriptions screen. Text/icon are
  set per-instance from SubscriptionsFragment (see bindFeatureGrid()).
  Reuses sub_card_outline for the card background/border, matching the
  plan cards and the rest of the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="5dp"
    android:paddingHorizontal="15dp">

    <ImageView
        android:id="@+id/featureIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/button_bg_round"
        android:backgroundTint="@color/white"
        android:contentDescription="@null"
        android:padding="10dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_done"
        app:tint="@color/appColor" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/featureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:text="@string/sub_feature_fonts_title"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/featureSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/regular"
            android:text="@string/sub_feature_fonts_subtitle"
            android:textColor="@color/gray"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>