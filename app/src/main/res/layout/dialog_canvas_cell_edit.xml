<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F2F2F2"
    android:padding="8dp">

    <!-- Top info row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCellPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/white"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="row 1 · col 1"
                android:textColor="#5F6368"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="&quot;نام&quot;"
                android:textColor="#8E94A2"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Done"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:fontFamily="@font/bold" />
    </RelativeLayout>

    <!-- Input row: Prev chevron | Edit text | Next chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPrevCell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <EditText
            android:id="@+id/editCellInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/white"
            android:gravity="center_vertical|end"
            android:hint="متن درج کریں"
            android:inputType="textMultiLine"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textColorHint="#8E94A2"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnNextCell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="12dp"
            android:rotation="180"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />
    </LinearLayout>

</LinearLayout>
