<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    tools:context=".ui.editor.panels.text.TextFragment">

    <!-- Guidelines matching original TextFragment -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.96" />

    <!-- ── Drag handle ── -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:src="@drawable/drag_handle_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════════════════════════
         COLLAPSED HEADER
         [addText] [addFont] [searchIcon | searchBar─────] [tabLayout→]
         ══════════════════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/headerCollapsed"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <LinearLayout
            android:id="@+id/tabRowContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/addText"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="#30005D28"
                android:padding="8dp"
                android:src="@drawable/ic_add_text" />

            <!-- Search icon — placed before fonts and tab selector -->
            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/gray" />

            <!-- Segmented Switch: Fonts / Presets -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/modeSwitchToolbar"
                android:layout_width="124dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnModeFonts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_bg_small"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:text="@string/fonts"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnModeStyles"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnModeStyles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_bg_small"
                    android:backgroundTint="@color/contrast"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:text="@string/presets"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnModeFonts"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/addFont"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:padding="8dp"
                android:src="@drawable/ic_add_font" />

            <!-- Single TabLayout — shows languages OR categories (never both at once) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/Widget.UrduCanvas.TabLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tabIndicatorHeight="0dp" />

        </LinearLayout>

        <!-- Full-width 1dp baseline divider -->
        <View
            android:id="@+id/tabBaselineDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         EXPANDED HEADER  (gone in collapsed state)
         Row 1: [modeSwitchExpanded] [addTextExpanded] [addFontExpanded] [close]
         Row 2: [Search here ──────────────────────────────────────────]
         ══════════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerExpanded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <!-- Mode Switch in Expanded Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/modeSwitchToolbarExpanded"
            android:layout_width="128dp"
            android:layout_height="28dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="@id/closePanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/closePanel">

            <TextView
                android:id="@+id/btnModeFontsExpanded"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:text="@string/fonts"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnModeStylesExpanded"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btnModeStylesExpanded"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:text="@string/presets"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnModeFontsExpanded"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/addTextExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="#30005D28"
            android:padding="7dp"
            android:src="@drawable/ic_add_text"
            app:layout_constraintBottom_toBottomOf="@id/closePanel"
            app:layout_constraintEnd_toStartOf="@id/addFontExpanded"
            app:layout_constraintTop_toTopOf="@id/closePanel"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/addFontExpanded"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="7dp"
            android:src="@drawable/ic_add_font"
            app:layout_constraintBottom_toBottomOf="@id/closePanel"
            app:layout_constraintEnd_toStartOf="@id/closePanel"
            app:layout_constraintTop_toTopOf="@id/closePanel"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/closePanel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/contrast"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/searchBarExpanded"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/button_bg_small"
            android:backgroundTint="@color/contrast"
            android:drawablePadding="6dp"
            android:fontFamily="@font/regular"
            android:hint="@string/search_here"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textColor="@color/black"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/closePanel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Single TabLayout for expanded state — shows languages OR categories -->
    <RelativeLayout
        android:id="@+id/tabExpandedContainer"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerExpanded">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutExpanded"
            style="@style/Widget.UrduCanvas.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            app:tabIndicatorHeight="0dp" />

        <!-- Full-width 1dp baseline divider -->
        <View
            android:id="@+id/tabBaselineDividerExpanded"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/tab_divider" />

    </RelativeLayout>

    <!-- Helper space that smoothly resizes to push RecyclerView down -->
    <View
        android:id="@+id/headerSpace"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <!-- SwipeRefreshLayout — only active in expanded state, shuffles list on pull -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSpace">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fontsRV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            tools:itemCount="20"
            tools:listitem="@layout/layout_font_item" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>