<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="50dp"
    android:layout_height="50dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/selection"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.5"
            app:shimmer_base_color="@color/contrast"
            app:shimmer_colored="true"
            app:shimmer_duration="700"
            app:shimmer_highlight_alpha="1.0"
            app:shimmer_repeat_delay="0">

            <ImageView
                android:id="@+id/font"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/contrast"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_background" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="3dp"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_gray" />

        <ImageView
            android:id="@+id/isPremium"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:src="@drawable/ic_premium_icon"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/download"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/white"
            android:padding="3dp"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            app:tint="@color/appColor" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
