<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ SIZE CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Rows Stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="Rows"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDecRows"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvRowsCount"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnIncRows"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Columns Stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="Columns"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDecCols"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvColsCount"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnIncCols"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ HEADER / FOOTER CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Header Row"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFooterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Footer Row"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHeaderCol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Header Column"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ═══ DIRECTION CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnRtl"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/appColor"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="RTL"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnLtr"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:text="LTR"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ═══ FIT CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewFit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnFitContent"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="Fit Content to Text"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ═══ RADIUS CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRadiusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:text="Corner Radius: 0dp"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="32"
                android:progress="0" />
        </LinearLayout>

        <!-- ═══ STYLE / PRESETS CATEGORY VIEW ═══ -->
        <LinearLayout
            android:id="@+id/viewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPresets"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
