<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resolutionButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/card_bg"
    android:foreground="?selectableItemBackground"
    android:padding="12dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_premium_icon"
        android:id="@+id/isPremium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/view1"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/button_bg"
        android:backgroundTint="@color/contrast"
        android:padding="8dp"
        android:src="@drawable/ic_resolution"
        app:tint="@color/gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/resolutionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/bold"
        android:text="@string/hd"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/resolutionValue"
        app:layout_constraintStart_toEndOf="@id/view1"
        app:layout_constraintTop_toTopOf="@id/view1" />

    <TextView
        android:id="@+id/resolutionValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/regular"
        android:text="1280 x 720"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/resolutionDesc"
        app:layout_constraintStart_toStartOf="@id/resolutionTitle"
        app:layout_constraintTop_toBottomOf="@id/resolutionTitle" />

    <TextView
        android:id="@+id/resolutionDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/regular"
        android:text="@string/standard_quality"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/resolutionDiff"
        app:layout_constraintStart_toStartOf="@id/resolutionTitle"
        app:layout_constraintTop_toBottomOf="@id/resolutionValue" />

    <TextView
        android:id="@+id/resolutionDiff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/regular"
        android:text="@string/_2_5_mb"
        android:textColor="@color/black"
        android:background="@drawable/edit_bg_stroke"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/view1"
        app:layout_constraintStart_toStartOf="@id/resolutionTitle"
        app:layout_constraintTop_toBottomOf="@id/resolutionDesc" />

    <ImageView
        android:visibility="gone"
        android:id="@+id/done"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_done_stroke"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@id/resolutionTitle"
        app:layout_constraintTop_toTopOf="@id/resolutionTitle"
        app:layout_constraintBottom_toBottomOf="@id/resolutionTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>