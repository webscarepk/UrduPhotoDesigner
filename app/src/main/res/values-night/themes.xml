<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UrduPhotoDesigner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:statusBarColor">@color/appColor</item>

        <!-- Icons ka color logic:
             false => light icons (white)  [use when status bar is dark/green]
             true  => dark icons (black)   [use when status bar is light] -->
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- in res/values/styles.xml -->
    <style name="CustomToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <!-- fontFamily can reference res/font -->
        <item name="fontFamily">@font/medium</item>
        <!-- textSize in sp -->
        <item name="android:textSize">12sp</item>
        <!-- textColor -->
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomToolbarSubtitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="fontFamily">@font/regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>

    <style name="PopupItemStyle">
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="PopupFadeAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_fade_in</item>
        <item name="android:windowExitAnimation">@anim/popup_fade_out</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="GlassActiveIndicator">
        <item name="android:color">#FF1A7A3A</item>
        <item name="shapeAppearance">@style/GlassIndicatorShape</item>
    </style>

    <style name="GlassIndicatorShape" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="NavLabelStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>