<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UrduPhotoDesigner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.UrduPhotoDesigner" parent="Base.Theme.UrduPhotoDesigner" />

    <!-- in res/values/styles.xml -->
    <style name="CustomToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <!-- fontFamily can reference res/font -->
        <item name="fontFamily">@font/medium</item>
        <!-- textSize in sp -->
        <item name="android:textSize">12sp</item>
        <!-- textColor -->
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomToolbarSubtitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="fontFamily">@font/regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>

    <style name="PopupItemStyle">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="PopupFadeAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_fade_in</item>
        <item name="android:windowExitAnimation">@anim/popup_fade_out</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="GlassActiveIndicator">
        <item name="android:color">#FF1A7A3A</item>
        <item name="shapeAppearance">@style/GlassIndicatorShape</item>
    </style>

    <style name="GlassIndicatorShape" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="NavLabelStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Theme.TransparentFragment" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!--
        Unified search field.

        Home's search bar is the reference; every other screen had re-declared the same
        widget by hand and drifted — templates and the fonts list used wrap_content
        instead of a fixed 40dp so they sat at a different height, the fonts list was
        15sp against everyone else's 12sp, and the magnifier was tinted on some screens
        and not others. Each layout keeps its own id, width, hint and constraints; only
        the appearance comes from here.
    -->
    <style name="Widget.UrduCanvas.SearchBar" parent="">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/button_bg_stroke_fill</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:drawableEnd">@drawable/ic_search</item>
        <item name="android:drawableTint">@color/gray</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">text</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:translationZ">1dp</item>
    </style>

    <!-- Unified Editor Properties Panel TabLayout Style -->
    <style name="Widget.UrduCanvas.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorAnimationMode">linear</item>
        <item name="tabIndicator">@drawable/bg_tab_indicator_rounded</item>
        <item name="tabIndicatorColor">@color/tab_selected_text</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabRippleColor">@color/tab_ripple</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabPaddingStart">0dp</item>
        <item name="tabPaddingEnd">0dp</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabPaddingBottom">0dp</item>
        <item name="tabTextAppearance">@style/TextAppearance.UrduCanvas.Tab</item>
    </style>

    <style name="TextAppearance.UrduCanvas.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textColor">@color/tab_unselected_text</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>