<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        A lasso reads through three things the old icon was missing: a *closed* loop, a
        cinch knot where the rope gathers, and a short taut tail below it. The previous
        drawing was two open arcs at the same weight, which came out as coiled rope.

        The loop is a wide ellipse — a thrown lasso is seen in perspective, not head-on —
        pinched at the bottom where the knot sits.
    -->
    <path
        android:strokeColor="@color/black"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,3.4 C16.8,3.4 20.6,6.2 20.6,9.7 C20.6,13.2 16.8,16 12,16 C7.2,16 3.4,13.2 3.4,9.7 C3.4,6.2 7.2,3.4 12,3.4 Z" />

    <!-- Cinch knot: a small ring the tail runs through. -->
    <path
        android:strokeColor="@color/black"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M10.4,16.1 C10.4,15.2 11.1,14.6 12,14.6 C12.9,14.6 13.6,15.2 13.6,16.1 C13.6,17 12.9,17.6 12,17.6 C11.1,17.6 10.4,17 10.4,16.1 Z" />

    <!-- Tail: short, straight and hanging, so the knot reads as the gather point. -->
    <path
        android:strokeColor="@color/black"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,17.6 L12,21.2" />

</vector>
