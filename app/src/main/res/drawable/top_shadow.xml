<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/top_shadow.xml
    A gradient that goes dark → transparent top to bottom.
    Apply this as the background of a thin View (12–16dp tall) placed
    just above panelNavHost. It mimics a top-only elevation shadow.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#26000000"
        android:startColor="@android:color/transparent"
        android:type="linear" />
</shape>