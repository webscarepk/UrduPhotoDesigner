<?xml version="1.0" encoding="utf-8"?>
<!--
    drawable/bottom_nav_top_shadow.xml
    A gradient that fades from semi-transparent black at bottom to transparent at top.
    Place as background on a thin View (6dp) directly above the BottomNavigationView
    to create a top-only separation shadow without default elevation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#1E000000"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
