<?xml version="1.0" encoding="utf-8"?>
<!--
    Tinted disc behind a drill-in tab's chevron.

    A bare arrow beside the label read as decoration — nothing about it said the tab would
    do something different if you tapped it again. Sitting it on the app-colour wash makes
    it a control, and it matches the breadcrumb chip the tab drills into.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#24005D28" />
</shape>
